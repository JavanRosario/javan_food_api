# ============================================
# COMPILAÇÃO E BUILD (JAVA / MAVEN / GRADLE)
# ============================================
*.class
*.jar
*.war
*.ear
*.nar
target/
**/target/
build/
**/build/
.gradle/
bin/
**/bin/

# Maven Wrapper & Logs
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next

# Gradle Wrapper
gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar

# ============================================
# ARQUIVOS DE AMBIENTE, SEGREDOS E BANCO
# ============================================
# Bloqueia variáveis de ambiente locais com credenciais
.env
.env.local
.env.*.local
*.secret
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Banco de dados embarcado local ou dumps
*.db
*.sqlite
*.h2.db
*.mv.db
*.trace.db

# ============================================
# IDEs & EDITORES DE CÓDIGO
# ============================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse / STS
.settings/
.project
.classpath
.factorypath
.metadata/
*.launch

# VS Code
.vscode/
*.code-workspace

# ============================================
# LOGS E DUMP DA JVM
# ============================================
logs/
*.log
*.log.*
*.pid
*.hprof
hs_err_pid*

# ============================================
# DOCKER & SISTEMA OPERACIONAL
# ============================================
# Ignora dados persitidos do Docker local e overrides
docker-data/
docker-compose.override.yml

# OS Junk
Thumbs.db
.DS_Store
*.tmp
*.temp
*.swp
*~

# ============================================
# REGRAS DE EXCEÇÃO (NÃO BLOQUEAR)
# ============================================
# Garante que arquivos essenciais do repositório subam
!.gitattributes
!.gitignore
!mvnw
!mvnw.cmd
!gradlew
!gradlew.bat